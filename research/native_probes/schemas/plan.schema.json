{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Silas-Asamoah/stormlog/research/native_probes/schemas/plan.schema.json",
  "title": "Stormlog native probe execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "configuration_id", "vendor", "seed", "repetitions", "environment_artifact", "artifact_root", "trials"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "native_probe_plan"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "configuration_id": {"type": "string", "minLength": 1},
    "vendor": {"enum": ["nvidia", "amd"]},
    "seed": {"type": "integer"},
    "repetitions": {"type": "integer", "minimum": 5},
    "environment_artifact": {"type": "string", "minLength": 1},
    "artifact_root": {"type": "string", "minLength": 1},
    "trials": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/plannedTrial"}}
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "environment", "timeout_seconds"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "plannedTrial": {
      "type": "object",
      "required": ["trial_id", "configuration_id", "workload_id", "mode", "repetition", "command"],
      "properties": {
        "trial_id": {"type": "string", "minLength": 1},
        "configuration_id": {"type": "string", "minLength": 1},
        "workload_id": {"enum": ["w1-eager", "w2-overlap", "w2-serialized", "w3-graph", "w4-stress", "vllm"]},
        "mode": {"type": "string", "minLength": 1},
        "repetition": {"type": "integer", "minimum": 0},
        "command": {"$ref": "#/$defs/command"}
      }
    }
  }
}
