{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Silas-Asamoah/stormlog/docs/schemas/studio_health_v1.schema.json",
  "title": "Stormlog Studio health v1",
  "description": "GET /api/v1/health, public (design §5.4). The page compares instance_id with the one stored beside its token and drops the token when they differ (§7.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "ok",
    "instance_id"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "stormlog.studio.health"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "instance_id": {
      "description": "Random per Studio process.",
      "$ref": "#/$defs/hex32"
    }
  },
  "$defs": {
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
