            },
            "memory_scope": {
              "const": "process_allocator"
            },
            "sampling": {
              "const": "passive"
            },
            "started_at_ns": {
              "minimum": 0,
              "type": "integer"
            },
            "stats_sampling": {
              "type": "boolean"
            },
