{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Silas-Asamoah/stormlog/docs/schemas/native_trace_manifest_v1.schema.json",
  "title": "Stormlog Native Trace Manifest v1",
  "description": "Bounded local native trace capture metadata; raw records stay in referenced artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "capture_id",
    "backend",
    "identity",
    "helper",
    "capture",
    "health",
    "loss",
    "artifacts",
    "metadata"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "format": {"type": "string", "const": "stormlog.native_trace"},
    "capture_id": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "enum": ["cupti_activity", "rocprofiler"]},
    "identity": {"$ref": "#/$defs/identity"},
    "helper": {"$ref": "#/$defs/helper"},
    "capture": {"$ref": "#/$defs/capture"},
    "health": {"$ref": "#/$defs/health"},
    "loss": {"$ref": "#/$defs/loss"},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "optionalString": {"type": ["string", "null"], "minLength": 1},
    "optionalNonNegativeInteger": {"type": ["integer", "null"], "minimum": 0},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "session_id", "job_id", "rank", "pid", "device_id"],
      "properties": {
        "run_id": {"$ref": "#/$defs/optionalString"},
        "session_id": {"type": "string", "minLength": 1},
        "job_id": {"$ref": "#/$defs/optionalString"},
        "rank": {"$ref": "#/$defs/optionalNonNegativeInteger"},
        "pid": {"type": "integer", "minimum": 1},
        "device_id": {"$ref": "#/$defs/optionalString"}
      }
    },
    "helper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "executable", "version"],
      "properties": {
        "protocol_version": {"type": "integer", "const": 1},
        "executable": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_ns",
        "ended_ns",
        "clock_domains",
        "requested_activities",
        "enabled_activities",
        "max_bytes",
        "privilege",
        "target_selector"
      ],
      "properties": {
        "started_ns": {"type": "integer", "minimum": 0},
        "ended_ns": {"$ref": "#/$defs/optionalNonNegativeInteger"},
        "clock_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "requested_activities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "enabled_activities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "max_bytes": {"type": "integer", "minimum": 1},
        "privilege": {"type": "string", "minLength": 1},
        "target_selector": {"type": "string", "minLength": 1}
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "partial",
        "partial_fields",
        "last_error",
        "consecutive_failures"
      ],
      "properties": {
        "status": {"type": "string", "enum": ["healthy", "degraded", "unhealthy"]},
        "partial": {"type": "boolean"},
        "partial_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "last_error": {"$ref": "#/$defs/optionalString"},
        "consecutive_failures": {"type": "integer", "minimum": 0}
      }
    },
    "loss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivered_records",
        "dropped_records",
        "bytes_written",
        "bytes_dropped",
        "truncated",
        "flush_outcome"
      ],
      "properties": {
        "delivered_records": {"type": "integer", "minimum": 0},
        "dropped_records": {"type": "integer", "minimum": 0},
        "bytes_written": {"type": "integer", "minimum": 0},
        "bytes_dropped": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "flush_outcome": {
          "type": "string",
          "enum": ["complete", "partial", "failed", "not_attempted"]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "content_type",
        "size_bytes",
        "sha256",
        "sensitive_fields"
      ],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "content_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sensitive_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
